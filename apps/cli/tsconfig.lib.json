{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../../libs/coach/domain/tsconfig.lib.json"
    },
    {
      "path": "../../libs/coach/application/tsconfig.lib.json"
    },
    {
      "path": "../../libs/coach/adapter-vault-mcp/tsconfig.lib.json"
    },
    {
      "path": "../../libs/coach/adapter-ollama/tsconfig.lib.json"
    },
    {
      "path": "../../libs/coach/adapter-local-state/tsconfig.lib.json"
    },
    {
      "path": "../../libs/coach/adapter-gemini/tsconfig.lib.json"
    }
  ],
  "exclude": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx"
  ]
}

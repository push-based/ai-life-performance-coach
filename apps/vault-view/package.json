{
  "name": "@ai-coach/vault-view",
  "version": "0.0.1",
  "private": true,
  "description": "Angular layered frontend for the vault view, built as an Nx dependency of @ai-coach/vault-adapter-view",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "ng build",
    "serve": "ng serve"
  },
  "dependencies": {
    "@ai-coach/vault-view-data-access": "*",
    "@ai-coach/vault-view-ui": "*",
    "@ai-coach/vault-view-util": "*",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/router": "21.2.25",
    "rxjs": "7.8.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.28",
    "@angular/cli": "21.2.28",
    "@angular/compiler-cli": "21.2.25"
  },
  "nx": {
    "projectType": "application",
    "tags": [
      "scope:vault-view",
      "architecture:layered",
      "type:app",
      "app:vault-view"
    ],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/dist"
        ],
        "options": {
          "command": "npm run build",
          "cwd": "apps/vault-view"
        }
      }
    }
  }
}

{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false, "packageManager": "pnpm" },
  "newProjectRoot": ".",
  "projects": {
    "climb-board": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist",
            "browser": "app/main.ts",
            "index": false,
            "tsConfig": "tsconfig.json",
            "styles": ["app/styles.css"],
            "outputHashing": "none",
            "optimization": true,
            "sourceMap": false,
            "extractLicenses": true,
            "budgets": [{ "type": "initial", "maximumWarning": "900kb", "maximumError": "1.5mb" }]
          }
        }
      }
    }
  }
}

{
  "mcpServers": {
    "life-vault": {
      "command": "node",
      "args": [
        "/absolute/path/to/ai-coach/packages/vault-server/dist/main.js",
        "serve",
        "--vault",
        "/absolute/path/to/your-vault"
      ]
    },
    "ai-coach-kb": {
      "command": "sh",
      "args": ["-c", "cd kb && exec docs-mcp serve"]
    }
  }
}
